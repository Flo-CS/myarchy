#!/usr/bin/env bash

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/myarchy/display"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/myarchy-display.lock"

# --- backend: compositor -----------------------------------------------------

mon_snapshot() {
	hyprctl monitors all -j 2>/dev/null | jq '[.[] | select((.description // "") != "")]'
}

mon_reload() {
	hyprctl reload >/dev/null
}

# Disabling a monitor does not relocate its workspaces (hyprwm/Hyprland#5052),
# so they become unreachable until moved off it explicitly.
migrate_workspaces() {
	local src="$1" dest="$2" id

	[[ -z $dest ]] && return

	while read -r id; do
		hyprctl dispatch moveworkspacetomonitor "$id" "$dest" >/dev/null
	done < <(hyprctl workspaces -j | jq -r --arg m "$src" '.[] | select(.monitor == $m) | .id')
}

lua_scalar() {
	if [[ $1 =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
		echo "$1"
	else
		echo "\"$1\""
	fi
}

lua_string() {
	printf '%s' "$1" | sed 's/[\\"]/\\&/g'
}

# --- model: queries over a snapshot ------------------------------------------

mon_names() {
	jq -r '.[].name' <<<"$1"
}

mon_enabled() {
	jq -r '.[] | select(.disabled | not) | .name' <<<"$1"
}

name_of_desc() {
	jq -r --arg d "$2" '[.[] | select(.description == $d) | .name] | first // ""' <<<"$1"
}

desc_of_name() {
	jq -r --arg n "$2" '[.[] | select(.name == $n) | .description] | first // ""' <<<"$1"
}

is_disabled() {
	[[ $(jq -r --arg n "$2" '[.[] | select(.name == $n) | .disabled] | first // false' <<<"$1") == true ]]
}

focused_monitor() {
	jq -r '[.[] | select(.focused == true) | .name] | first // ""' <<<"$1"
}

list_monitors() {
	jq -r '
		.[] | [
			.name,
			(.description // ""),
			"\(.width)x\(.height)@\(.refreshRate | floor)",
			(if .disabled then "disabled" else "enabled" end)
		] | @tsv' <<<"$1"
}

list_modes() {
	jq -r --arg n "$2" '.[] | select(.name == $n) | .availableModes[] | sub("Hz$"; "")' <<<"$1"
}

# --- state: profiles ---------------------------------------------------------

profile_key() {
	jq -r '.[].description' <<<"$1" | sort | sha256sum | cut -c1-12
}

profile_file() {
	echo "$STATE_DIR/$(profile_key "$1").lua"
}

anchor_file() {
	echo "$STATE_DIR/$(profile_key "$1").primary"
}

geometry_file() {
	echo "$STATE_DIR/$(profile_key "$1").rows"
}

layout_rows() {
	jq -r '
		. as $all
		| .[]
		# mirrorOf reports an id, not always a name
		| ((.mirrorOf // "none") | tostring) as $mirror
		| [
			(.description // ""),
			(if .disabled then "0" else "1" end),
			"\(.width)x\(.height)@\(.refreshRate)",
			"\(.x)x\(.y)",
			(.scale | tostring),
			(if $mirror == "none" then "none"
			 else (([$all[]
				| select((.name == $mirror) or ((.id | tostring) == $mirror))
				| .description] | first) // "none") end)
		] | @tsv' <<<"$1"
}

emit_rules() {
	local desc enabled mode position scale mirror

	while IFS=$'\t' read -r desc enabled mode position scale mirror; do
		if [[ $enabled == 0 ]]; then
			printf 'hl.monitor({ output = "desc:%s", disabled = true })\n' "$(lua_string "$desc")"
		elif [[ $mirror == none ]]; then
			printf 'hl.monitor({ output = "desc:%s", mode = "%s", position = "%s", scale = %s, mirror = "", disabled = false })\n' \
				"$(lua_string "$desc")" "$mode" "$position" "$(lua_scalar "$scale")"
		else
			printf 'hl.monitor({ output = "desc:%s", mode = "%s", position = "auto", scale = %s, mirror = "desc:%s", disabled = false })\n' \
				"$(lua_string "$desc")" "$mode" "$(lua_scalar "$scale")" "$(lua_string "$mirror")"
		fi
	done
}

write_profile() {
	local file="$1" tmp

	mkdir -p "$STATE_DIR"
	tmp=$(mktemp "$file.XXXXXX")
	emit_rules >"$tmp"
	mv "$tmp" "$file"
}

link_current() {
	ln -sfT "$(basename "$1")" "$STATE_DIR/current.lua"
}

save_profile() {
	local file
	file=$(profile_file "$1")

	write_profile "$file" < <(current_rows "$1")
	link_current "$file"
}

anchor_desc() {
	local file
	file=$(anchor_file "$1")

	[[ -f $file ]] && cat "$file"
}

anchor_name() {
	local desc
	desc=$(anchor_desc "$1")

	[[ -n $desc ]] && name_of_desc "$1" "$desc"
}

set_anchor() {
	local snap="$1" name="$2" desc

	desc=$(desc_of_name "$snap" "$name")

	if [[ -z $desc ]]; then
		echo "Unknown monitor: $name" >&2
		return 1
	fi

	mkdir -p "$STATE_DIR"
	echo "$desc" >"$(anchor_file "$snap")"
}

anchor_or_focused() {
	local snap="$1" desc name

	desc=$(anchor_desc "$snap")
	if [[ -n $desc ]]; then
		name=$(name_of_desc "$snap" "$desc")
		[[ -n $name ]] && echo "$name" && return 0
	fi

	name=$(focused_monitor "$snap")
	[[ -n $name ]] && echo "$name" && return 0

	mon_enabled "$snap" | head -n 1
}

# --- engine: layouts ---------------------------------------------------------

# Rules land asynchronously
settle() {
	local cur sig prev i

	cur=$(mon_snapshot)
	prev=$(layout_rows "$cur")
	for ((i = 0; i < 20; i++)); do
		sleep 0.1
		cur=$(mon_snapshot)
		sig=$(layout_rows "$cur")
		if [[ $sig == "$prev" ]]; then
			printf '%s' "$cur"
			return 0
		fi
		prev=$sig
	done

	printf '%s' "$cur"
	return 1
}

set_field() {
	awk -F'\t' -v OFS='\t' -v d="$2" -v i="$3" -v v="$4" '$1 == d { $i = v } 1' <<<"$1"
}

# hyprctl reports 0x0 for a disabled monitor's mode/position/scale, so a
# disabled row falls back to the last known-good geometry instead of that.
merge_disabled_geometry() {
	awk -F'\t' -v OFS='\t' '
		NR==FNR { fallback[$1] = $3 OFS $4 OFS $5 OFS $6; next }
		{
			if ($2 == "0" && ($1 in fallback)) {
				split(fallback[$1], f, OFS)
				$3 = f[1]; $4 = f[2]; $5 = f[3]; $6 = f[4]
			}
			print
		}
	' <(printf '%s\n' "$1") <(printf '%s\n' "$2")
}

cached_row() {
	local file
	file=$(geometry_file "$1")
	[[ -f $file ]] && awk -F'\t' -v d="$2" '$1 == d' "$file"
}

current_rows() {
	local snap="$1" file
	file=$(geometry_file "$snap")

	if [[ -f $file ]]; then
		merge_disabled_geometry "$(cat "$file")" "$(layout_rows "$snap")"
	else
		layout_rows "$snap"
	fi
}

# Writing the rules is what applies them, so the layout is re-read afterwards
# and stored as the concrete geometry the compositor settled on. Disabled
# rows keep whatever geometry they came in with — settling can't recover it.
apply_layout() {
	local rows="$1" snap file settled merged

	snap=$(mon_snapshot)
	file=$(profile_file "$snap")

	write_profile "$file" <<<"$rows"
	link_current "$file"
	mon_reload

	settled=$(settle) || echo "layout still moving, saving the last reading" >&2

	merged=$(merge_disabled_geometry "$rows" "$(layout_rows "$settled")")
	write_profile "$file" <<<"$merged"
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$merged" >"$(geometry_file "$snap")"

	printf '%s' "$settled"
}

extend() {
	local direction="$1" snap anchor position

	case "$direction" in
	left) position="auto-left" ;;
	right) position="auto-right" ;;
	above) position="auto-up" ;;
	below) position="auto-down" ;;
	*)
		echo "Unknown direction: $direction" >&2
		return 1
		;;
	esac

	snap=$(mon_snapshot)
	anchor=$(desc_of_name "$snap" "$(anchor_or_focused "$snap")")

	apply_layout "$(jq -r --arg a "$anchor" --arg p "$position" '
		.[] | [
			(.description // ""), "1", "preferred",
			(if (.description // "") == $a then "0x0" else $p end),
			(if .scale > 0 then (.scale | tostring) else "auto" end),
			"none"
		] | @tsv' <<<"$snap")" >/dev/null
}

# Hyprland scales the anchor by the smaller axis ratio, so sizes may differ
mirror() {
	local snap anchor

	snap=$(mon_snapshot)
	anchor=$(desc_of_name "$snap" "$(anchor_or_focused "$snap")")

	apply_layout "$(jq -r --arg a "$anchor" '
		.[] | (.description // "") as $d | [
			$d, "1", "preferred",
			(if $d == $a then "0x0" else "auto" end),
			(if .scale > 0 then (.scale | tostring) else "auto" end),
			(if $d == $a then "none" else $a end)
		] | @tsv' <<<"$snap")" >/dev/null
}

# Laying the whole axis out sequentially is what makes overlap impossible
place() {
	local name="$1" side="$2" ref="$3" snap horizontal n x y w h offset rows
	local -A X Y W H
	local -a screens=() order=()

	case "$side" in
	left-of | right-of) horizontal=true ;;
	above | below) horizontal=false ;;
	*)
		echo "Unknown side: $side" >&2
		return 1
		;;
	esac

	if [[ $name == "$ref" ]]; then
		echo "Cannot place a monitor relative to itself" >&2
		return 1
	fi

	snap=$(mon_snapshot)

	while IFS=$'\t' read -r n x y w h; do
		X[$n]=$x
		Y[$n]=$y
		W[$n]=$w
		H[$n]=$h
		screens+=("$n")
		[[ $n == "$name" ]] || order+=("$n")
	done < <(jq -r --argjson horizontal "$horizontal" '
		[.[] | select(.disabled | not)
			| {name, x, y, w: (.width / .scale | round), h: (.height / .scale | round)}]
		| sort_by(if $horizontal then .x else .y end)
		| .[] | [.name, .x, .y, .w, .h] | @tsv' <<<"$snap")

	if [[ -z ${X[$name]+set} || -z ${X[$ref]+set} ]]; then
		echo "Cannot place $name $side $ref" >&2
		return 1
	fi

	local -a moved=()
	for n in "${order[@]}"; do
		if [[ $n == "$ref" && ($side == left-of || $side == above) ]]; then
			moved+=("$name")
		fi
		moved+=("$n")
		if [[ $n == "$ref" && ($side == right-of || $side == below) ]]; then
			moved+=("$name")
		fi
	done

	rows=$(current_rows "$snap")

	offset=0
	for n in "${moved[@]}"; do
		if [[ $horizontal == true ]]; then
			rows=$(set_field "$rows" "$(desc_of_name "$snap" "$n")" 4 "${offset}x${Y[$n]}")
			((offset += W[$n]))
		else
			rows=$(set_field "$rows" "$(desc_of_name "$snap" "$n")" 4 "${X[$n]}x${offset}")
			((offset += H[$n]))
		fi
	done

	apply_layout "$rows" >/dev/null
}

only() {
	local keep="$1" snap keep_desc rows settled name

	snap=$(mon_snapshot)
	keep_desc=$(desc_of_name "$snap" "$keep")

	if [[ -z $keep_desc ]]; then
		echo "Unknown monitor: $keep" >&2
		return 1
	fi

	while read -r name; do
		[[ $name == "$keep" ]] && continue
		migrate_workspaces "$name" "$keep"
	done < <(mon_enabled "$snap")

	rows=$(current_rows "$snap")
	rows=$(set_field "$rows" "$keep_desc" 2 1)
	rows=$(set_field "$rows" "$keep_desc" 3 preferred)
	rows=$(set_field "$rows" "$keep_desc" 4 "0x0")
	while read -r name; do
		[[ $name == "$keep" ]] && continue
		rows=$(set_field "$rows" "$(desc_of_name "$snap" "$name")" 2 0)
	done < <(mon_names "$snap")

	settled=$(apply_layout "$rows")

	while read -r name; do
		[[ $name == "$keep" ]] && continue
		if ! is_disabled "$settled" "$name"; then
			echo "$name did not switch off" >&2
			return 1
		fi
	done < <(mon_names "$snap")

	set_anchor "$settled" "$keep"
}

enable_monitor() {
	local name="$1" snap desc rows settled

	snap=$(mon_snapshot)
	desc=$(desc_of_name "$snap" "$name")

	if [[ -z $desc ]]; then
		echo "Unknown monitor: $name" >&2
		return 1
	fi

	rows=$(current_rows "$snap")
	if [[ -z $(cached_row "$snap" "$desc") ]]; then
		rows=$(set_field "$rows" "$desc" 3 preferred)
		rows=$(set_field "$rows" "$desc" 4 auto)
	fi
	if [[ $(awk -F'\t' -v d="$desc" '$1 == d { print $5 }' <<<"$rows") == 0 ]]; then
		rows=$(set_field "$rows" "$desc" 5 auto)
	fi
	rows=$(set_field "$rows" "$desc" 2 1)

	settled=$(apply_layout "$rows")

	if is_disabled "$settled" "$name"; then
		echo "$name did not switch on" >&2
		return 1
	fi
}

disable_monitor() {
	local name="$1" snap desc settled dest

	snap=$(mon_snapshot)
	desc=$(desc_of_name "$snap" "$name")

	if [[ -z $desc ]]; then
		echo "Unknown monitor: $name" >&2
		return 1
	fi

	if [[ $(mon_enabled "$snap" | wc -l) -le 1 ]]; then
		notify-send "Display" "Cannot disable the last enabled screen" -i video-display
		return 1
	fi

	dest=$(mon_enabled "$snap" | grep -vx "$name" | head -n 1)
	migrate_workspaces "$name" "$dest"

	settled=$(apply_layout "$(set_field "$(current_rows "$snap")" "$desc" 2 0)")

	if ! is_disabled "$settled" "$name"; then
		echo "$name did not switch off" >&2
		return 1
	fi
}

toggle_monitor() {
	if is_disabled "$(mon_snapshot)" "$1"; then
		enable_monitor "$1"
	else
		disable_monitor "$1"
	fi
}

set_mode() {
	local snap
	snap=$(mon_snapshot)

	apply_layout "$(set_field "$(current_rows "$snap")" "$(desc_of_name "$snap" "$1")" 3 "$2")" >/dev/null
}

set_scale() {
	local snap
	snap=$(mon_snapshot)

	apply_layout "$(set_field "$(current_rows "$snap")" "$(desc_of_name "$snap" "$1")" 5 "$2")" >/dev/null
}

# 2 means nothing saved. Doing nothing on a match is what stops our own writes
# looping back through the hotplug hooks.
apply_profile() {
	local snap="$1" file

	file=$(profile_file "$snap")
	[[ -f $file ]] || return 2

	link_current "$file"

	if [[ $(layout_rows "$snap" | emit_rules) == "$(cat "$file")" ]]; then
		return 0
	fi

	mon_reload
}

reset_layout() {
	local snap
	snap=$(mon_snapshot)

	rm -f "$(profile_file "$snap")" "$(anchor_file "$snap")" "$(geometry_file "$snap")" "$STATE_DIR/current.lua"
	mon_reload
}

# Entry point for the monitor.added/removed and hyprland.start hooks
auto() {
	local snap name

	exec 9>"$LOCK_FILE"
	flock -w 5 9 || return 0

	snap=$(settle)

	# A failed reload must not reach the extend below
	apply_profile "$snap"
	case $? in
	0) return 0 ;;
	2) ;;
	*) return 1 ;;
	esac

	if [[ $(jq -r 'length' <<<"$snap") -le 1 ]]; then
		save_profile "$snap"
		return 0
	fi

	extend right || return 1

	name=$(mon_enabled "$(mon_snapshot)" | tail -n 1)
	notify-send "Screen connected" \
		"$name extended to the right — MOD+P for display options" \
		-i video-display -t 8000
}

# --- frontend: CLI -----------------------------------------------------------

case "$1" in
list)
	list_monitors "$(mon_snapshot)"
	;;
list-modes)
	list_modes "$(mon_snapshot)" "$2"
	;;
extend)
	extend "$2"
	;;
place)
	place "$2" "$3" "$4"
	;;
mirror)
	mirror
	;;
only)
	only "$2"
	;;
enable)
	enable_monitor "$2"
	;;
disable)
	disable_monitor "$2"
	;;
toggle)
	toggle_monitor "$2"
	;;
set-mode)
	set_mode "$2" "$3"
	;;
set-scale)
	set_scale "$2" "$3"
	;;
primary)
	set_anchor "$(mon_snapshot)" "$2"
	;;
anchor)
	anchor_name "$(mon_snapshot)"
	;;
save)
	save_profile "$(mon_snapshot)"
	;;
apply)
	apply_profile "$(settle)"
	;;
auto)
	auto
	;;
reset)
	reset_layout
	;;
*)
	echo "Usage: $0 {list|list-modes <name>|extend <left|right|above|below>|place <name> <left-of|right-of|above|below> <ref>|mirror|only <name>|enable <name>|disable <name>|toggle <name>|set-mode <name> <mode>|set-scale <name> <scale>|primary <name>|anchor|save|apply|auto|reset}" >&2
	exit 1
	;;
esac
