#!/usr/bin/env bash

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/myarchy/display"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/myarchy-display.lock"

# --- backend: compositor -----------------------------------------------------

# `all` is what includes disabled outputs
mon_snapshot() {
	hyprctl monitors all -j 2>/dev/null
}

# `keyword` is a no-op on Lua configs and `eval` answers ok for rejected rules
mon_eval() {
	local out

	if ! out=$(hyprctl repl "$1" 2>&1); then
		echo "monitor rule rejected: ${out:-$1}" >&2
		return 1
	fi
}

# `mirror` and `disabled` are sticky, so both are always spelled out
mon_apply() {
	mon_eval "hl.monitor({ output = \"$1\", mode = \"$2\", position = \"$3\", scale = $(lua_scalar "$4"), mirror = \"${5-}\", disabled = false })"
}

mon_disable() {
	mon_eval "hl.monitor({ output = \"$1\", disabled = true })"
}

mon_reload() {
	hyprctl reload >/dev/null
}

lua_scalar() {
	if [[ $1 =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
		echo "$1"
	else
		echo "\"$1\""
	fi
}

# --- model: queries over a snapshot ------------------------------------------

mon_names() {
	jq -r '.[].name' <<<"$1"
}

mon_enabled() {
	jq -r '.[] | select(.disabled | not) | .name' <<<"$1"
}

name_of_desc() {
	jq -r --arg d "$2" '[.[] | select(.description == $d) | .name] | first // ""' <<<"$1"
}

desc_of_name() {
	jq -r --arg n "$2" '[.[] | select(.name == $n) | .description] | first // ""' <<<"$1"
}

mode_of() {
	jq -r --arg n "$2" '
		[.[] | select(.name == $n) | "\(.width)x\(.height)@\(.refreshRate)"] | first // "preferred"' <<<"$1"
}

position_of() {
	jq -r --arg n "$2" '[.[] | select(.name == $n) | "\(.x)x\(.y)"] | first // "auto"' <<<"$1"
}

scale_of() {
	jq -r --arg n "$2" '[.[] | select(.name == $n) | .scale] | first // "auto"' <<<"$1"
}

is_disabled() {
	[[ $(jq -r --arg n "$2" '[.[] | select(.name == $n) | .disabled] | first // false' <<<"$1") == true ]]
}

focused_monitor() {
	jq -r '[.[] | select(.focused == true) | .name] | first // ""' <<<"$1"
}

list_monitors() {
	jq -r '
		.[] | [
			.name,
			(.description // ""),
			"\(.width)x\(.height)@\(.refreshRate | floor)",
			(if .disabled then "disabled" else "enabled" end)
		] | @tsv' <<<"$1"
}

list_modes() {
	jq -r --arg n "$2" '.[] | select(.name == $n) | .availableModes[] | sub("Hz$"; "")' <<<"$1"
}

# --- state: profiles ---------------------------------------------------------

# Descriptions, not names: DP-1/DP-2 renumber across re-plugs
profile_key() {
	jq -r '.[].description' <<<"$1" | sort | sha256sum | cut -c1-12
}

profile_file() {
	echo "$STATE_DIR/$(profile_key "$1").tsv"
}

anchor_file() {
	echo "$STATE_DIR/$(profile_key "$1").primary"
}

layout_signature() {
	jq -r '
		. as $all
		| .[]
		# mirrorOf reports an id, not always a name
		| ((.mirrorOf // "none") | tostring) as $mirror
		| [
			(.description // ""),
			(if .disabled then "0" else "1" end),
			"\(.width)x\(.height)@\(.refreshRate)",
			"\(.x)x\(.y)",
			(.scale | tostring),
			(if $mirror == "none" then "none"
			 else (([$all[]
				| select((.name == $mirror) or ((.id | tostring) == $mirror))
				| .description] | first) // "none") end)
		] | @tsv' <<<"$1"
}

save_profile() {
	mkdir -p "$STATE_DIR"
	layout_signature "$1" >"$(profile_file "$1")"
}

anchor_desc() {
	local file
	file=$(anchor_file "$1")

	[[ -f $file ]] && cat "$file"
}

anchor_name() {
	local desc
	desc=$(anchor_desc "$1")

	[[ -n $desc ]] && name_of_desc "$1" "$desc"
}

set_anchor() {
	local snap="$1" name="$2" desc

	desc=$(desc_of_name "$snap" "$name")

	if [[ -z $desc ]]; then
		echo "Unknown monitor: $name" >&2
		return 1
	fi

	mkdir -p "$STATE_DIR"
	echo "$desc" >"$(anchor_file "$snap")"
}

anchor_or_focused() {
	local snap="$1" desc name

	desc=$(anchor_desc "$snap")
	if [[ -n $desc ]]; then
		name=$(name_of_desc "$snap" "$desc")
		[[ -n $name ]] && echo "$name" && return 0
	fi

	name=$(focused_monitor "$snap")
	[[ -n $name ]] && echo "$name" && return 0

	mon_enabled "$snap" | head -n 1
}

# --- engine: layouts ---------------------------------------------------------

# Rules land asynchronously
settle() {
	local cur sig prev i

	cur=$(mon_snapshot)
	prev=$(layout_signature "$cur")
	for ((i = 0; i < 20; i++)); do
		sleep 0.1
		cur=$(mon_snapshot)
		sig=$(layout_signature "$cur")
		if [[ $sig == "$prev" ]]; then
			printf '%s' "$cur"
			return 0
		fi
		prev=$sig
	done

	printf '%s' "$cur"
	return 1
}

# The catch-all rule re-flows any screen a change does not mention
pin_others() {
	local snap="$1" skip="$2" name

	while read -r name; do
		[[ $name == "$skip" ]] && continue
		mon_apply "$name" "$(mode_of "$snap" "$name")" "$(position_of "$snap" "$name")" \
			"$(scale_of "$snap" "$name")" || return 1
	done < <(mon_enabled "$snap")
}

settle_and_save() {
	local settled

	settled=$(settle) || echo "layout still moving, saving the last reading" >&2

	save_profile "$settled"
	printf '%s' "$settled"
}

extend() {
	local direction="$1" snap anchor name position

	case "$direction" in
	left) position="auto-left" ;;
	right) position="auto-right" ;;
	above) position="auto-up" ;;
	below) position="auto-down" ;;
	*)
		echo "Unknown direction: $direction" >&2
		return 1
		;;
	esac

	snap=$(mon_snapshot)
	anchor=$(anchor_or_focused "$snap")

	mon_apply "$anchor" preferred 0x0 "$(scale_of "$snap" "$anchor")" || return 1

	while read -r name; do
		[[ $name == "$anchor" ]] && continue
		mon_apply "$name" preferred "$position" "$(scale_of "$snap" "$name")" || return 1
	done < <(mon_names "$snap")

	settle_and_save >/dev/null
}

# Hyprland scales the anchor by the smaller axis ratio, so sizes may differ
mirror() {
	local snap anchor name

	snap=$(mon_snapshot)
	anchor=$(anchor_or_focused "$snap")

	mon_apply "$anchor" preferred 0x0 "$(scale_of "$snap" "$anchor")" || return 1

	while read -r name; do
		[[ $name == "$anchor" ]] && continue
		mon_apply "$name" preferred auto "$(scale_of "$snap" "$name")" "$anchor" || return 1
	done < <(mon_names "$snap")

	settle_and_save >/dev/null
}

# Laying the whole axis out sequentially is what makes overlap impossible
place() {
	local name="$1" side="$2" ref="$3" snap horizontal row n x y w h offset
	local -A X Y W H
	local -a screens=() order=()

	case "$side" in
	left-of | right-of) horizontal=true ;;
	above | below) horizontal=false ;;
	*)
		echo "Unknown side: $side" >&2
		return 1
		;;
	esac

	if [[ $name == "$ref" ]]; then
		echo "Cannot place a monitor relative to itself" >&2
		return 1
	fi

	snap=$(mon_snapshot)

	while IFS=$'\t' read -r n x y w h; do
		X[$n]=$x
		Y[$n]=$y
		W[$n]=$w
		H[$n]=$h
		screens+=("$n")
		[[ $n == "$name" ]] || order+=("$n")
	done < <(jq -r --argjson horizontal "$horizontal" '
		[.[] | select(.disabled | not)
			| {name, x, y, w: (.width / .scale | round), h: (.height / .scale | round)}]
		| sort_by(if $horizontal then .x else .y end)
		| .[] | [.name, .x, .y, .w, .h] | @tsv' <<<"$snap")

	if [[ -z ${X[$name]+set} || -z ${X[$ref]+set} ]]; then
		echo "Cannot place $name $side $ref" >&2
		return 1
	fi

	local -a moved=()
	for n in "${order[@]}"; do
		if [[ $n == "$ref" && ($side == left-of || $side == above) ]]; then
			moved+=("$name")
		fi
		moved+=("$n")
		if [[ $n == "$ref" && ($side == right-of || $side == below) ]]; then
			moved+=("$name")
		fi
	done

	offset=0
	for n in "${moved[@]}"; do
		if [[ $horizontal == true ]]; then
			mon_apply "$n" "$(mode_of "$snap" "$n")" "${offset}x${Y[$n]}" "$(scale_of "$snap" "$n")" || return 1
			((offset += W[$n]))
		else
			mon_apply "$n" "$(mode_of "$snap" "$n")" "${X[$n]}x${offset}" "$(scale_of "$snap" "$n")" || return 1
			((offset += H[$n]))
		fi
	done

	settle_and_save >/dev/null
}

only() {
	local keep="$1" snap settled name

	snap=$(mon_snapshot)

	if [[ -z $(desc_of_name "$snap" "$keep") ]]; then
		echo "Unknown monitor: $keep" >&2
		return 1
	fi

	mon_apply "$keep" preferred 0x0 "$(scale_of "$snap" "$keep")" || return 1

	while read -r name; do
		[[ $name == "$keep" ]] && continue
		mon_disable "$name" || return 1
	done < <(mon_names "$snap")

	settled=$(settle_and_save)

	while read -r name; do
		[[ $name == "$keep" ]] && continue
		if ! is_disabled "$settled" "$name"; then
			echo "$name did not switch off" >&2
			return 1
		fi
	done < <(mon_names "$snap")

	set_anchor "$settled" "$keep"
}

enable_monitor() {
	local name="$1" settled

	mon_apply "$name" preferred auto auto || return 1

	settled=$(settle_and_save)

	if is_disabled "$settled" "$name"; then
		echo "$name did not switch on" >&2
		return 1
	fi
}

disable_monitor() {
	local name="$1" snap settled

	snap=$(mon_snapshot)

	if [[ $(mon_enabled "$snap" | wc -l) -le 1 ]]; then
		notify-send "Display" "Cannot disable the last enabled screen" -i video-display
		return 1
	fi

	mon_disable "$name" || return 1

	settled=$(settle_and_save)

	if ! is_disabled "$settled" "$name"; then
		echo "$name did not switch off" >&2
		return 1
	fi
}

toggle_monitor() {
	if is_disabled "$(mon_snapshot)" "$1"; then
		enable_monitor "$1"
	else
		disable_monitor "$1"
	fi
}

set_mode() {
	local name="$1" mode="$2" snap

	snap=$(mon_snapshot)

	pin_others "$snap" "$name" || return 1
	mon_apply "$name" "$mode" "$(position_of "$snap" "$name")" "$(scale_of "$snap" "$name")" || return 1

	settle_and_save >/dev/null
}

set_scale() {
	local name="$1" scale="$2" snap

	snap=$(mon_snapshot)

	pin_others "$snap" "$name" || return 1
	mon_apply "$name" "$(mode_of "$snap" "$name")" "$(position_of "$snap" "$name")" "$scale" || return 1

	settle_and_save >/dev/null
}

# 2 means nothing saved, 1 means a rule was rejected. Doing nothing on a match is
# what stops our own writes looping back through the hotplug hooks.
apply_profile() {
	local snap="$1" file desc enabled mode position scale mirror name mirror_name

	file=$(profile_file "$snap")
	[[ -f $file ]] || return 2

	if [[ $(layout_signature "$snap") == "$(cat "$file")" ]]; then
		return 0
	fi

	while IFS=$'\t' read -r desc enabled mode position scale mirror; do
		name=$(name_of_desc "$snap" "$desc")
		[[ -z $name ]] && continue

		if [[ $enabled == 0 ]]; then
			mon_disable "$name" || return 1
			continue
		fi

		if [[ $mirror != "none" && -n $mirror ]]; then
			mirror_name=$(name_of_desc "$snap" "$mirror")
			[[ -z $mirror_name ]] && continue
			mon_apply "$name" "$mode" auto "$scale" "$mirror_name" || return 1
		else
			mon_apply "$name" "$mode" "$position" "$scale" || return 1
		fi
	done <"$file"
}

reset_layout() {
	local snap
	snap=$(mon_snapshot)

	rm -f "$(profile_file "$snap")" "$(anchor_file "$snap")"
	mon_reload
}

# Entry point for the monitor.added/removed and hyprland.start hooks
auto() {
	local snap name

	exec 9>"$LOCK_FILE"
	flock -w 5 9 || return 0

	snap=$(settle)

	# A rejected rule must not reach the extend below
	apply_profile "$snap"
	case $? in
	0) return 0 ;;
	2) ;;
	*) return 1 ;;
	esac

	if [[ $(jq -r 'length' <<<"$snap") -le 1 ]]; then
		save_profile "$snap"
		return 0
	fi

	extend right || return 1

	name=$(mon_enabled "$(mon_snapshot)" | tail -n 1)
	notify-send "Screen connected" \
		"$name extended to the right — MOD+P for display options" \
		-i video-display -t 8000
}

# --- frontend: CLI -----------------------------------------------------------

case "$1" in
list)
	list_monitors "$(mon_snapshot)"
	;;
list-modes)
	list_modes "$(mon_snapshot)" "$2"
	;;
extend)
	extend "$2"
	;;
place)
	place "$2" "$3" "$4"
	;;
mirror)
	mirror
	;;
only)
	only "$2"
	;;
enable)
	enable_monitor "$2"
	;;
disable)
	disable_monitor "$2"
	;;
toggle)
	toggle_monitor "$2"
	;;
set-mode)
	set_mode "$2" "$3"
	;;
set-scale)
	set_scale "$2" "$3"
	;;
primary)
	set_anchor "$(mon_snapshot)" "$2"
	;;
anchor)
	anchor_name "$(mon_snapshot)"
	;;
save)
	save_profile "$(mon_snapshot)"
	;;
apply)
	apply_profile "$(settle)"
	;;
auto)
	auto
	;;
reset)
	reset_layout
	;;
*)
	echo "Usage: $0 {list|list-modes <name>|extend <left|right|above|below>|place <name> <left-of|right-of|above|below> <ref>|mirror|only <name>|enable <name>|disable <name>|toggle <name>|set-mode <name> <mode>|set-scale <name> <scale>|primary <name>|anchor|save|apply|auto|reset}" >&2
	exit 1
	;;
esac
