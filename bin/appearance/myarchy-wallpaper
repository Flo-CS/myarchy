#!/usr/bin/env bash

WALLPAPERS_DIR="$MYARCHY_DIR/wallpapers"

init_wallpaper() {
	if [[ ! -f "$WALLPAPERS_DIR/current" ]]; then
		echo "Setting default wallpaper"
		set_wallpaper $(list_wallpapers | head -n 1)
	fi
}

get_wallpaper() {
	wallpaper_path=$(readlink -f "$WALLPAPERS_DIR/current")
	wallpaper_name=$(basename "$wallpaper_path")

	echo "$wallpaper_name"
}

list_wallpapers() {
	fd --glob "*" "$WALLPAPERS_DIR/" --format {/}
}

get_wallpapers_dir() {
	echo "$WALLPAPERS_DIR"
}

set_wallpaper() {
	wallpaper_path="$WALLPAPERS_DIR/$1"

	ln -sfT "$wallpaper_path" "$WALLPAPERS_DIR/current"

	if ! hyprctl hyprpaper wallpaper ",$wallpaper_path" >/dev/null 2>&1; then
		hyprpaper &
		disown
	fi

	save_preferred
}

apply_preferred() {
	wallpaper_name=$(myarchy-theme get-var wallpaper)

	if [ -z "$wallpaper_name" ]; then
		echo "No wallpaper name found in the current theme."
		exit 1
	fi

	set_wallpaper "$wallpaper_name"
}

save_preferred() {
	wallpaper_name=$(get_wallpaper)

	myarchy-theme set-var wallpaper "$wallpaper_name"
}

case "$1" in
init)
	init_wallpaper
	;;
get)
	get_wallpaper
	;;
list)
	list_wallpapers
	;;
dir)
	get_wallpapers_dir
	;;
set)
	set_wallpaper "$2"
	;;
apply-preferred)
	apply_preferred
	;;
save-preferred)
	save_preferred
	;;
*)
	echo "Usage: $0 {get|list|dir|set <wallpaper_name>|apply-preferred|save-preferred|init}" >&2
	exit 1
	;;
esac
