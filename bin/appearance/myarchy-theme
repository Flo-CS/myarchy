#!/usr/bin/env bash

THEMES_DIR="$MYARCHY_DIR/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
RENDERED_DIR_NAME=".rendered"

# Symlink to the rendered directory of the current theme
CURRENT_DIR="$THEMES_DIR/current"

init_theme() {
	if [[ ! -L "$CURRENT_DIR" ]]; then
		echo "Setting default theme"
		set_theme "$(list_themes | head -n 1)"
	fi

	render_theme
}

get_theme() {
	local rendered_path=$(readlink -f "$CURRENT_DIR")
	local theme_name=$(basename "$(dirname "$rendered_path")")

	echo "$theme_name"
}

list_themes() {
	fd --glob "*" "$THEMES_DIR/" --format {/} --max-depth 1 --type directory --exclude current --exclude templates
}

set_theme() {
	render_theme "$1"

	myarchy-wallpaper apply-preferred
	myarchy-cursor apply-preferred

	myarchy-refresh all
}

get_var() {
	sed -nE "s@^$1=(.*)\$@\1@p" "$THEMES_DIR/$(get_theme)/vars.txt"
}

set_var() {
	sed -i -E "s@^$1=.*@$1=$(escape_replacement "$2")@" "$THEMES_DIR/$(get_theme)/vars.txt"
}

# Escapes a value so that it can be used as a sed replacement
escape_replacement() {
	printf '%s' "$1" | sed 's/[\\&@]/\\&/g'
}

# Renders $TEMPLATES_DIR/<software>/<name> to $THEMES_DIR/<theme>/$RENDERED_DIR_NAME/<software>/<name>,
# then points $CURRENT_DIR at that rendered directory. Substitutes:
#   {{color|hex}} -> #rrggbb    {{color|hex:aa}} -> #rrggbbaa
#   {{color|raw}} -> rrggbb     {{color|raw:aa}} -> rrggbbaa
#   {{var}}       -> value from vars.txt (plus the built-in {{theme-name}})
render_theme() {
	local theme_name="${1:-$(get_theme)}"
	local theme_dir="$THEMES_DIR/$theme_name"
	local palette_file="$theme_dir/palette.txt"
	local vars_file="$theme_dir/vars.txt"

	if [[ ! -f "$palette_file" || ! -f "$vars_file" ]]; then
		echo "Theme $theme_name is missing palette.txt or vars.txt" >&2
		exit 1
	fi

	local sed_script=$(mktemp)
	local output_dir=$(mktemp -d)

	while read -r color name || [[ -n "$color" ]]; do
		[[ -z "$name" ]] && continue

		color=$(escape_replacement "${color#\#}")

		printf '%s\n' "s@\{\{$name\|hex(:([0-9a-fA-F]{2}))?\}\}@#$color\2@g" >>"$sed_script"
		printf '%s\n' "s@\{\{$name\|raw(:([0-9a-fA-F]{2}))?\}\}@$color\2@g" >>"$sed_script"
	done <"$palette_file"

	printf '%s\n' "s@\{\{theme-name\}\}@$(escape_replacement "$theme_name")@g" >>"$sed_script"

	while IFS='=' read -r key value || [[ -n "$key" ]]; do
		[[ -z "$key" || "$key" == \#* ]] && continue

		printf '%s\n' "s@\{\{$key\}\}@$(escape_replacement "$value")@g" >>"$sed_script"
	done <"$vars_file"

	local template output
	while read -r template; do
		output="$output_dir/${template#$TEMPLATES_DIR/}"

		mkdir -p "$(dirname "$output")"
		sed -E -f "$sed_script" "$template" >"$output"
		# Some renders are executed rather than sourced, keep the template mode
		chmod --reference="$template" "$output"
	done < <(find "$TEMPLATES_DIR" -type f)

	local unresolved=$(grep -rhoE '\{\{[^}]*\}\}' "$output_dir" | sort -u | tr '\n' ' ')
	if [[ -n "$unresolved" ]]; then
		echo "Theme $theme_name does not define: $unresolved" >&2
		rm -rf "$sed_script" "$output_dir"
		exit 1
	fi

	rm -rf "$theme_dir/$RENDERED_DIR_NAME"
	mkdir -p "$theme_dir/$RENDERED_DIR_NAME"
	cp -r "$output_dir"/. "$theme_dir/$RENDERED_DIR_NAME"
	ln -sfT "$theme_name/$RENDERED_DIR_NAME" "$CURRENT_DIR"

	rm -rf "$sed_script" "$output_dir"

	apply_desktop_settings

	echo "Rendered theme $theme_name"
}

# Mirrors the theme into dconf, which is what xdg-desktop-portal exposes as
# org.freedesktop.appearance. Apps asking the portal for the system color scheme
# (Firefox, Chromium, Electron, GTK4) ignore the gtk .ini files and read this instead.
apply_desktop_settings() {
	command -v gsettings >/dev/null || return 0

	local color_scheme="prefer-light"
	[[ "$(get_var gtk-prefer-dark)" == "1" ]] && color_scheme="prefer-dark"

	local interface="org.gnome.desktop.interface"
	gsettings set "$interface" color-scheme "$color_scheme"
	gsettings set "$interface" gtk-theme "$(get_var gtk-theme)"
	gsettings set "$interface" icon-theme "$(get_var gtk-icon-theme)"
	gsettings set "$interface" font-name "$(get_var gtk-font)"
	gsettings set "$interface" cursor-theme "$(get_var cursor-name)"
	gsettings set "$interface" cursor-size "$(get_var cursor-size)"
}

case "$1" in
init)
	init_theme
	;;
get)
	get_theme
	;;
list)
	list_themes
	;;
set)
	set_theme "$2"
	;;
render)
	render_theme "$2"
	;;
get-var)
	get_var "$2"
	;;
set-var)
	set_var "$2" "$3"
	;;
*)
	echo "Usage: myarchy-theme {init|get|list|set <theme>|render [theme]|get-var <key>|set-var <key> <value>}" >&2
	exit 1
	;;
esac
