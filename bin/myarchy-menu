#!/usr/bin/env bash

# System menu in a single rofi window, via rofi "script mode" (rofi-script(5)):
# rofi re-runs this script on every selection, we print the next menu's rows,
# and submenus swap in place.
#
# A row's info field holds a command from this script, executed on selection.
# ROFI_DATA holds the trail of open menus, current first: "size=Bibata cursor main".

SELF=$(realpath "$0")

opt() { printf '\0%s\x1f%s\n' "$1" "$2"; } # rofi option
row() {
	printf '%s\0info\x1f%s\n' "$1" "$2"
	has_rows=1
} # row <label> <command>

# --- row actions ------------------------------------------------------------

# Wait for the menu to close before running, so nothing appears under the
# backdrop. Rofi forks us away and is not our parent, so find it by name.
run() {
	local rofi
	rofi=$(pgrep -n -x rofi)
	setsid --fork bash -c "tail -s 0.05 --pid=${rofi:-$$} -f /dev/null; $*" >/dev/null 2>&1 &
}

term() { run myarchy-terminal launch "$@"; }
term_big() { run myarchy-terminal launch-big "$@"; }
term_menu() { run myarchy-terminal launch-menu "$@"; }

# Pickers get their own rofi window, overlapping ours so the backdrop stays up.
# Except reboot-to: its polkit prompt needs our keyboard grab gone first.
pick() {
	case $1 in
	reboot-to) run "$SELF" --picker "$1" ;;
	*) setsid --fork "$SELF" --picker "$1" >/dev/null 2>&1 & ;;
	esac
}

# Run now and redraw the current menu, so a change is visible without closing.
# Has to be a helper: ROFI_INFO is word-split, not eval'd, so ";" in a row's
# command is passed along as a literal argument.
apply() {
	"$@"
	reshow
}

toggle_drive() {
	if [[ -z $(myarchy-drive mountpoint "$1") ]]; then
		run myarchy-drive mount "$1"
	else
		run myarchy-drive unmount "$1"
	fi
}

# --- menus -------------------------------------------------------------------

show() {
	local menu=$1 has_rows=

	opt use-hot-keys true
	opt data "$menu${ROFI_DATA:+ $ROFI_DATA}"

	case $menu in
	main)
		opt prompt "▶"
		row "Theme" "show theme"
		row "Wallpaper" "pick wallpaper"
		row "Cursor" "show cursor"
		row "Display" "show display"
		row "Power" "show power"
		row "Emoji" "pick emoji"
		row "System" "show system"
		row "Bluetooth" "term bluetuith --no-warning"
		row "Network" "term nmtui"
		row "Audio" "term wiremix"
		row "Screenshot" "show screenshot"
		row "Monitor" "term_big btop"
		row "Info" "term_menu fastfetch"
		row "Snapshot system" "term_menu myarchy-snapshot create"
		row "Packages" "show packages"
		row "Apps" "show apps"
		row "Refresh" "term_menu myarchy-refresh all"
		row "Deploy" "term_menu myarchy-deploy all"
		row "Update" "term_menu myarchy-update all"
		row "Drives" "show drives"
		row "Edit config" "show edit-config"
		;;
	theme)
		opt prompt "Theme"
		local theme
		while read -r theme; do
			row "$theme" "run myarchy-theme set $theme"
		done < <(myarchy-theme list)
		;;
	cursor)
		opt prompt "Cursor"
		local cursor
		while read -r cursor; do
			row "$cursor" "show size=$cursor"
		done < <(myarchyctl cursor list)
		;;
	size=*)
		opt prompt "Size"
		local size
		for size in 16 24 32 48 64; do
			row "$size" "run myarchyctl --notify cursor set ${menu#size=} $size"
		done
		;;
	display)
		opt prompt "Display"
		local name desc mode state
		row "Extend" "show extend"
		row "Duplicate" "run myarchyctl --notify display mirror"
		while IFS=$'\t' read -r name desc mode state; do
			row "Only $name" "run myarchyctl --notify display only $name"
		done < <(myarchyctl display list)
		row "Monitors" "show monitors"
		row "Brightness" "show brightness"
		row "Night Light" "show nightlight"
		row "Reset" "run myarchyctl --notify display reset"
		;;
	# Applied straight away, then the menu redraws, so you see each step
	brightness)
		opt prompt "Brightness"
		local screen
		while read -r screen; do
			row "$screen" "show brightness=$screen"
		done < <(myarchyctl brightness monitors)
		;;
	brightness=*)
		opt prompt "Brightness ${menu#brightness=} ($(myarchyctl brightness get "${menu#brightness=}" --dirty)%)"
		local percent
		for percent in 10 25 50 75 100; do
			row "$percent%" "apply myarchyctl --notify brightness set ${menu#brightness=} $percent --dirty"
		done
		;;
	nightlight)
		local current
		current=$(myarchyctl nightlight get)
		[[ $current != off ]] && current="${current}%"
		opt prompt "Night Light ($current)"
		row "Off" "apply myarchyctl --notify nightlight off"
		local percent
		for percent in 10 25 50 75 100; do
			row "$percent%" "apply myarchyctl --notify nightlight set $percent"
		done
		;;
	extend)
		opt prompt "Extend"
		row "Right" "run myarchyctl --notify display extend right"
		row "Left" "run myarchyctl --notify display extend left"
		row "Above" "run myarchyctl --notify display extend above"
		row "Below" "run myarchyctl --notify display extend below"
		;;
	monitors)
		opt prompt "Monitors"
		local name desc mode state anchor mark
		anchor=$(myarchyctl display anchor)
		while IFS=$'\t' read -r name desc mode state; do
			mark=""
			[[ -n $anchor && $name == "$anchor" ]] && mark="  (anchor)"
			row "$name  $desc  $mode  $state$mark" "show monitor=$name"
		done < <(myarchyctl display list)
		;;
	monitor=*)
		opt prompt "${menu#monitor=}"
		row "Position" "show place=${menu#monitor=}"
		row "Toggle" "run myarchyctl --notify display toggle ${menu#monitor=}"
		row "Set As Anchor" "run myarchyctl --notify display primary ${menu#monitor=}"
		row "Resolution" "show mode=${menu#monitor=}"
		row "Scale" "show scale=${menu#monitor=}"
		;;
	place=*:*)
		# must come before place=*
		local target=${menu#place=} name desc mode state
		local side=${target#*:}
		target=${target%%:*}
		opt prompt "$target $side"
		while IFS=$'\t' read -r name desc mode state; do
			[[ $name == "$target" ]] && continue
			row "$name  $desc" "run myarchyctl --notify display place $target $side $name"
		done < <(myarchyctl display list)
		;;
	place=*)
		opt prompt "Position ${menu#place=}"
		local side
		for side in left-of right-of above below; do
			row "$side" "show place=${menu#place=}:$side"
		done
		;;
	mode=*)
		opt prompt "Resolution"
		local mode
		while read -r mode; do
			row "$mode" "run myarchyctl --notify display set-mode ${menu#mode=} $mode"
		done < <(myarchyctl display list-modes "${menu#mode=}")
		;;
	scale=*)
		opt prompt "Scale (or type one)"
		local scale
		for scale in auto 0.5 0.75 0.8 0.9 1 1.1 1.2 1.25 1.3 1.4 1.5 1.6 1.667 1.75 1.8 2 2.5 3; do
			row "$scale" "run myarchyctl --notify display set-scale ${menu#scale=} $scale"
		done
		;;
	# The GPU toggle needs sudo, and a polkit dialog would land under rofi's
	# overlay layer, hence a terminal
	power)
		opt prompt "Power"
		local profile current mark gpu
		current=$(myarchy-power profile-get)
		while read -r profile; do
			mark=""
			[[ $profile == "$current" ]] && mark="  (current)"
			row "$profile$mark" "apply myarchy-power profile-set $profile"
		done < <(myarchy-power profiles-list)
		if [[ $(myarchy-battery presence) == true ]]; then
			if gpu=$(myarchy-power gpu-sleep-get 2>/dev/null); then
				row "GPU sleep: $gpu ($(myarchy-power gpu-state))" "term_menu myarchy-power gpu-sleep-toggle"
			fi
			row "Battery: $(myarchy-battery percentage)% ($(myarchy-battery state))" "reshow"
		fi
		;;
	system)
		opt prompt "System"
		row "Reboot" "run systemctl reboot"
		row "Reboot to" "pick reboot-to"
		row "Shutdown" "run systemctl poweroff"
		row "Sleep" "run systemctl suspend"
		;;
	screenshot)
		opt prompt "Screenshot"
		row "Fullscreen" "run myarchy-screenshot fullscreen"
		row "Area" "run myarchy-screenshot area"
		row "Window" "run myarchy-screenshot window"
		;;
	packages)
		opt prompt "Packages"
		row "Install Package" "term_menu myarchy-pkg install"
		row "Install AUR Package" "term_menu myarchy-pkg yay-install"
		row "Install Flatpak user" "term_menu myarchy-flatpak user install"
		row "Install Flatpak system" "term_menu myarchy-flatpak system install"
		row "Remove Package" "term_menu myarchy-pkg remove"
		row "Remove Flatpak user" "term_menu myarchy-flatpak user remove"
		row "Remove Flatpak system" "term_menu myarchy-flatpak system remove"
		;;
	apps)
		opt prompt "Apps"
		row "Install Webapp" "term_menu myarchy-webapp install"
		row "Install Appimage" "term_menu myarchy-appimage install"
		row "Install TUI" "term_menu myarchy-tui install"
		row "Remove TUI" "term_menu myarchy-tui remove"
		row "Remove Appimage" "term_menu myarchy-appimage remove"
		row "Remove Webapp" "term_menu myarchy-webapp remove"
		;;
	drives)
		opt prompt "Drives"
		local device rest
		while read -r device rest; do
			row "$device $rest" "toggle_drive $device"
		done < <(myarchy-drive list)
		;;
	edit-config)
		opt prompt "Edit config"
		row "Hyprland apps" "term nvim $MYARCHY_DIR/config/hypr/hyprland/apps.lua"
		;;
	esac

	# A menu with no rows makes rofi quit, and Escape only reaches us while a
	# row is selected, so never leave one empty
	[[ $has_rows ]] || row "Nothing here" "reshow"
}

reshow() {
	local current rest
	read -r current rest <<<"${ROFI_DATA:-main}"
	ROFI_DATA=$rest
	show "$current"
}

back() {
	[[ ${ROFI_DATA-} == *" "* ]] || return 0 # at the root: closes the menu
	ROFI_DATA=${ROFI_DATA#* }                # drop the current menu
	reshow
}

typed() {
	local current rest
	read -r current rest <<<"${ROFI_DATA:-main}"
	if [[ $current == size=* && $1 =~ ^[0-9]+$ ]]; then
		run myarchyctl --notify cursor set "${current#size=}" "$1"
	elif [[ $current == scale=* && $1 =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
		run myarchyctl --notify display set-scale "${current#scale=}" "$1"
	else
		reshow
	fi
}

# --- pickers: menus that need their own rofi window --------------------------

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/myarchy-menu-picker.pid"

picker_wallpaper() {
	# Script mode can't resize row icons, hence a separate window
	local dir selected
	dir=$(myarchyctl wallpaper dir)
	selected=$(myarchyctl wallpaper list |
		while read -r wallpaper; do
			printf '%s\0icon\x1f%s\n' "$wallpaper" "$dir/$wallpaper"
		done |
		rofi -pid "$PIDFILE" -dmenu -i -p "Wallpaper" -show-icons -theme-str '
			listview { lines: 6; }
			element { padding: 4px 16px; }
			element-icon { size: 72px; }')
	[[ -n $selected ]] && myarchyctl --notify wallpaper set "$selected"
}

picker_reboot_to() {
	local selected
	selected=$(myarchy-reboot-to list | rofi -dmenu -i -p "Reboot to")
	[[ -n $selected ]] && myarchy-reboot-to reboot "$selected"
}

picker_emoji() {
	rofi -pid "$PIDFILE" -modi emoji -show emoji -display-emoji "Emoji"
}

# --- entry points -------------------------------------------------------------

if [[ ${1-} == --picker ]]; then
	case ${2-} in
	wallpaper) picker_wallpaper ;;
	reboot-to) picker_reboot_to ;;
	emoji) picker_emoji ;;
	esac
	exit
fi

if [[ -z ${ROFI_RETV-} ]]; then
	# Run by hand: replace any open rofi (it holds a lock file), with Escape
	# remapped from "quit" to hot key 19, our "back". Ctrl+G still quits.
	# An argument opens straight at that submenu; rofi runs us as a child.
	export MYARCHY_MENU_ROOT=${1:-main}
	pkill -x rofi
	for _ in {1..40}; do
		pgrep -x rofi >/dev/null || break
		sleep 0.025
	done
	exec rofi -show menu -modes "menu:$SELF" -i \
		-kb-cancel "Control+g,Control+bracketleft" \
		-kb-custom-19 "Escape"
fi

case $ROFI_RETV in
0) show "${MYARCHY_MENU_ROOT:-main}" ;;
1) $ROFI_INFO ;; # the selected row's info field is a command, run it
2) typed "$1" ;;
28) back ;; # hot key 19: Escape
*) reshow ;;
esac
