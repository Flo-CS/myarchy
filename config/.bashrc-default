#!/usr/bin/env bash

source ~/.config/rc/functions.sh
source ~/.config/rc/aliases.sh
source ~/.config/rc/theming.sh
source ~/.config/rc/settings.sh

[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh

# keychain (python) costs ~800ms per run; reuse the cached agent env when it's still valid
keychain_file="$HOME/.keychain/$(hostname)-sh"
[[ -r $keychain_file ]] && source "$keychain_file"
if [[ ! -S $SSH_AUTH_SOCK ]] || ! kill -0 "$SSH_AGENT_PID" 2>/dev/null; then
    eval "$(keychain --eval)"
fi
unset keychain_file

eval "$(starship init bash)"

eval "$(zoxide init bash)"

eval "$(direnv hook bash)"

eval "$(fzf --bash)"

command -v myarchyctl >/dev/null && source <(COMPLETE=bash myarchyctl)

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm.sh takes ~400ms to source; load it lazily on first use instead
_load_nvm() {
    unset -f nvm node npm npx _load_nvm
    [ -f /usr/share/nvm/init-nvm.sh ] && . /usr/share/nvm/init-nvm.sh
}
nvm() { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm() { _load_nvm; npm "$@"; }
npx() { _load_nvm; npx "$@"; }

export DEV_TOOLS_PATH="$HOME/dev/tools"

export PATH="$DEV_TOOLS_PATH/flutter/bin:$PATH"

export ANDROID_AVD_HOME="$HOME/.config/.android/avd"
export ANDROID_SDK_HOME="$DEV_TOOLS_PATH/android/sdk"

export SOPS_EDITOR="vim -u NONE -U NONE -n -i NONE -c 'set nobackup nowritebackup noswapfile noundofile'"
