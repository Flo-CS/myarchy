#!/usr/bin/env bash

set -eEo pipefail

# Copy greetd config to /etc/greetd/
sudo myarchy-lib robust-copy \
	"$MYARCHY_DIR/install/global/files/greetd/config.toml" \
	/etc/greetd/config.toml

# --force to take over display-manager.service from the ISO's own login manager
sudo systemctl enable --force greetd.service

echo "✓ Login manager configured. Reboot to use greetd."
