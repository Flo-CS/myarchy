#!/usr/bin/env bash

# EndeavourOS ships firewalld, which would fight ufw over nftables
sudo systemctl disable --now firewalld.service || echo "firewalld is not enabled, skipping"
sudo pacman -Rns --noconfirm firewalld || echo "firewalld is already uninstalled, skipping"

# Allow nothing in, everything out
sudo ufw default deny incoming
sudo ufw default allow outgoing

# Turn on the firewall
sudo ufw --force enable

# Enable UFW systemd service to start on boot
sudo systemctl enable ufw
