#!/usr/bin/env bash

set -eEo pipefail

# VARS

export MYARCHY_DIR="$HOME/.local/share/myarchy"

STATE_DIR="$HOME/.local/state/myarchy"
STEPS_FILE="$STATE_DIR/install-steps"
LOG_FILE="$STATE_DIR/install.log"

mkdir -p "$STATE_DIR"

CURRENT_STEP="preflight"
trap 'echo "install failed at step: $CURRENT_STEP (see $LOG_FILE)" >&2' ERR

# Skips steps already done by a previous failed run. MYARCHY_FORCE=1 replays them.
step() {
	local name="$1"
	shift

	if [ -z "$MYARCHY_FORCE" ] && grep -Fxq "$name" "$STEPS_FILE" 2>/dev/null; then
		echo "== skip $name"
		return 0
	fi

	CURRENT_STEP="$name"
	echo "== $name"
	source "$MYARCHY_DIR/install/$name" "$@"
	echo "$name" >>"$STEPS_FILE"
}

source $MYARCHY_DIR/install/preflight

export MYARCHY_INSTANCE_ID=${MYARCHY_INSTANCE_ID:-$(gum input --header "Enter your myarchy instance ID used to identify specific local configurations (e.g. 'desktop', 'laptop')")}

# After the prompt so gum keeps its tty
exec > >(tee -a "$LOG_FILE") 2>&1

# GLOBAL / SYSTEM

step global/deploy-myarchy-lib

step global/config-pacman

step global/install-packages

step global/config-sudoers
step global/config-bluetooth
step global/config-docker
step global/config-firewall
step global/config-faillock
step global/config-system-backups
step global/config-terminal
step global/config-power
step global/config-nvidia-power
step global/config-ddc
step global/config-grub-menu-entries
step global/config-grub-menu-config
step global/config-grub-reboot-to
step global/config-boot-splashscreen spinner_alt
step global/config-login-manager

# USER

step user/install-packages

step user/build-bin
step user/deploy-bin
step user/deploy-config

step user/config-battery-and-power

rm -f "$STEPS_FILE"

myarchy-refresh all
