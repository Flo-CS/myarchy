# Main background
theme[main_bg]="{{surface|hex}}"

# Main text color
theme[main_fg]="{{foreground-strong|hex}}"

# Title color for boxes
theme[title]="{{foreground-muted|hex}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{accent|hex}}"

# Background color of selected items
theme[selected_bg]="{{accent|hex}}"

# Foreground color of selected items
theme[selected_fg]="{{on-accent|hex}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{foreground-subtle|hex}}"

# Color of text appearing on top of graphs
theme[graph_text]="{{foreground-strong|hex}}"

# Misc colors for processes box
theme[proc_misc]="{{foreground-strong|hex}}"

# Cpu box outline color
theme[cpu_box]="{{outline-strong|hex}}"

# Memory/disks box outline color
theme[mem_box]="{{outline-strong|hex}}"

# Net up/down box outline color
theme[net_box]="{{outline-strong|hex}}"

# Processes box outline color
theme[proc_box]="{{outline-strong|hex}}"

# Box divider line and small boxes line color
theme[div_line]="{{outline-strong|hex}}"

# Temperature graph colors
theme[temp_start]="{{foreground-muted|hex}}"
theme[temp_mid]="{{accent|hex}}"
theme[temp_end]="{{alert|hex}}"

# CPU graph colors
theme[cpu_start]="{{foreground-muted|hex}}"
theme[cpu_mid]="{{accent|hex}}"
theme[cpu_end]="{{alert|hex}}"

# Mem/Disk free meter
theme[free_start]="{{foreground-muted|hex}}"
theme[free_mid]="{{accent|hex}}"
theme[free_end]="{{alert|hex}}"

# Mem/Disk cached meter
theme[cached_start]="{{foreground-muted|hex}}"
theme[cached_mid]="{{accent|hex}}"
theme[cached_end]="{{alert|hex}}"

# Mem/Disk available meter
theme[available_start]="{{foreground-muted|hex}}"
theme[available_mid]="{{accent|hex}}"
theme[available_end]="{{alert|hex}}"

# Mem/Disk used meter
theme[used_start]="{{foreground-muted|hex}}"
theme[used_mid]="{{accent|hex}}"
theme[used_end]="{{alert|hex}}"

# Download graph colors
theme[download_start]="{{foreground-muted|hex}}"
theme[download_mid]="{{accent|hex}}"
theme[download_end]="{{alert|hex}}"

# Upload graph colors
theme[upload_start]="{{foreground-muted|hex}}"
theme[upload_mid]="{{accent|hex}}"
theme[upload_end]="{{alert|hex}}"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="{{foreground-muted|hex}}"
theme[process_mid]="{{accent|hex}}"
theme[process_end]="{{alert|hex}}"
